{
  "version": "0.3.2",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "check": "tsc --noEmit"
  },
  "name": "@camada/node",
  "description": "camada backend SDK for Node: request capture, inline blocking, first-party beacon serving; Express/Fastify/Nest/Koa adapters",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./fastify": {
      "import": {
        "types": "./dist/fastify.d.ts",
        "default": "./dist/fastify.js"
      },
      "require": {
        "types": "./dist/fastify.d.cts",
        "default": "./dist/fastify.cjs"
      }
    },
    "./nest": {
      "import": {
        "types": "./dist/nest.d.ts",
        "default": "./dist/nest.js"
      },
      "require": {
        "types": "./dist/nest.d.cts",
        "default": "./dist/nest.cjs"
      }
    },
    "./koa": {
      "import": {
        "types": "./dist/koa.d.ts",
        "default": "./dist/koa.js"
      },
      "require": {
        "types": "./dist/koa.d.cts",
        "default": "./dist/koa.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "fastify": [
        "./dist/fastify.d.ts"
      ],
      "nest": [
        "./dist/nest.d.ts"
      ],
      "koa": [
        "./dist/koa.d.ts"
      ]
    }
  },
  "dependencies": {
    "@camada/browser": "file:../camada-browser",
    "@camada/core": "file:../camada-core"
  },
  "devDependencies": {
    "@koa/bodyparser": "^6.1.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@types/express": "^4.17.25",
    "@types/koa": "^2.15.2",
    "@types/koa-mount": "^4.0.5",
    "@types/node": "^22.10.0",
    "express": "^4.21.0",
    "fastify": "^5.2.0",
    "koa": "^2.15.0",
    "koa-mount": "^4.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    }
  }
}
